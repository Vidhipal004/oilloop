# Local development (optional). Without DATABASE_URL, OilLoop runs in browser-demo mode.
DATABASE_URL=postgresql://username:password@localhost:5432/oilloop
API_PORT=4000
# Generate a unique 32+ character secret for production. Render can generate this automatically.
JWT_SECRET=replace-with-a-long-random-secret
# Set PGSSL=true if your PostgreSQL provider requires TLS; Render/Neon/Supabase URLs are auto-detected.
PGSSL=false
PG_POOL_MAX=5
